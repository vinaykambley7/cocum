# Server Configuration
PORT=5000
NODE_ENV=development

# SMTP / Email Service Configuration
# Compatible with Gmail, SendGrid, Amazon SES, Outlook, Mailgun, Resend, or any standard SMTP server
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_PROVIDER_API_KEY=

# Sender Identity & Application Links
EMAIL_FROM="Commonwealth University College of Medicine" <reports@cucom.edu.ag>
PORTAL_URL=http://localhost:3000

# Daily Automatic Reminder Schedule (6:00 PM Asia/Kolkata)
REMINDER_TIME=18:00
REMINDER_CRON=0 18 * * *
TIMEZONE=Asia/Kolkata
